# Copy to .env.local only to override the defaults. scripts/secrets.sh
# generates the repository root's .env (git-ignored), symlinked here as
# .env, so `npm run dev` and the Docker stack share the same secrets.

# The origin browsers reach this application at, which it names itself by
# (sign-in redirects, the storage service's IRIs). Unset, it is the
# request's own, which the development server accepts with a warning; a
# production server (npm start, the Docker image) won't start without it.
#PUBLIC_URL=http://localhost:3000

# The storage service (../storage), proxied as /api/storage.
STORAGE_URL=http://localhost:8080

# The Keycloak realm people sign in with, and this application's client in it
# (../identity/realm/reviews-realm.json).
KEYCLOAK_ISSUER=http://localhost:8180/realms/reviews
# Where this server reaches Keycloak, when not at the issuer's address (in
# Docker: http://keycloak:8080). Browsers still sign in at KEYCLOAK_ISSUER.
#KEYCLOAK_INTERNAL_URL=
KEYCLOAK_CLIENT_ID=presentation
# The client secret, from the repository root's .env: it must match the
# realm's (PRESENTATION_CLIENT_SECRET).
KEYCLOAK_CLIENT_SECRET=

# Encrypts the session cookie, which holds the user's tokens: 32 characters
# or more, from the repository root's .env (SESSION_SECRET).
SESSION_SECRET=

# A production build refuses to run without KEYCLOAK_CLIENT_SECRET unless
# this is true — a development deployment only (the stack leaves it false).
#ALLOW_DEV_SECRETS=true
