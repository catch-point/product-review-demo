{
  // Run the storage service under the debugger (needs the Extension Pack for Java).
  "version": "0.2.0",
  "configurations": [
    {
      // Uses the Docker services from tasks.json: Keycloak on :8180 and the
      // storage database on :5433. It serves on :8081, so it can run next to the
      // storage container (:8080) and share its data. Actuator is on :9081.
      // It connects to that database as reviews_service, and migrates the
      // schema itself as its owner, reviews_owner, as storage-migrate does;
      // images go to the stack's MinIO on :9100 as its own user
      // (application.yml's defaults).
      "name": "Storage: Debug (Docker services)",
      "type": "java",
      "request": "launch",
      "projectName": "storage",
      "mainClass": "ca.leighnet.reviews.storage.StorageApplication",
      "cwd": "${workspaceFolder}/storage",
      "preLaunchTask": "Storage: Start dependencies",
      // The repository root's .env (scripts/secrets.sh), not VS Code's own
      // environment: STORAGE_DB_SERVICE_PASSWORD and STORAGE_DB_OWNER_PASSWORD
      // reach application.yml's datasource and Flyway placeholders,
      // MINIO_IMAGES_SECRET_KEY the images' bucket, ACTUATOR_PASSWORD the
      // actuator's account (curl -u actuator:… on :9081), and JWT_SECRET the
      // development token secret, used only with DEV_TOKENS=true in .env.
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SERVER_PORT": "8081",
        "MANAGEMENT_SERVER_PORT": "9081",
        "MANAGEMENT_SERVER_ADDRESS": "127.0.0.1",
        // Keycloak's tokens, as the browser-facing issuer names them, checked
        // against its keys (both through the edge on :8180).
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI": "http://localhost:8180/realms/reviews",
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI": "http://localhost:8180/realms/reviews/protocol/openid-connect/certs",
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES": "storage"
      }
    },
    {
      // Starts throwaway PostgreSQL and MinIO containers with Testcontainers;
      // no data is kept. It serves on :8082, with actuator on :9082. Only
      // development tokens are accepted (no Keycloak), signed with .env's
      // JWT_SECRET, so the seed scripts work against it:
      //   BASE=http://localhost:8082 storage/scripts/seed-products.sh
      "name": "Storage: Debug (Testcontainers)",
      "type": "java",
      "request": "launch",
      "projectName": "storage",
      "mainClass": "ca.leighnet.reviews.storage.TestStorageApplication",
      "classPaths": ["$Test"],
      "cwd": "${workspaceFolder}/storage",
      // Makes .env on a fresh checkout, which envFile needs.
      "preLaunchTask": "Secrets: Generate",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SERVER_PORT": "8082",
        "MANAGEMENT_SERVER_PORT": "9082",
        "MANAGEMENT_SERVER_ADDRESS": "127.0.0.1",
        // So Testcontainers starts the throwaway containers on the daemon the
        // tasks use as well, whatever reviews.dockerContext selects.
        "DOCKER_CONTEXT": "${config:reviews.dockerContext}"
      }
    }
  ]
}
