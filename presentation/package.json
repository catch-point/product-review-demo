{
  "name": "presentation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./client-address.cjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --require ./client-address.cjs node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "openid-client": "^6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
